# Zkopírujte tento soubor jako .env a doplňte hodnoty.
# Soubor .env je v .gitignore – nikdy se nenahraje na GitHub.

# Povinné pro ostrý běh (Anthropic Console → API Keys):
ANTHROPIC_API_KEY=

# Jen pokud klíč není přiřazený k pracovnímu prostoru (chyba 'not scoped to a workspace'):
# ID ve tvaru wrkspc_... najdete v Console → Settings → Workspaces.
ANTHROPIC_WORKSPACE_ID=

# Volitelné – bez klíče se OpenAlex téměř nepoužije (denní rozpočet bez klíče je velmi malý):
# https://openalex.org/settings/api
OPENALEX_API_KEY=

# Volitelné – kontaktní e-mail pro Crossref (rychlejší "polite pool"):
CONTACT_EMAIL=
